# ---- flags ----
CPPFLAGS_DEBUG="-Wall -Wextra -Wshadow -std=c++17 -g -fsanitize=undefined,address -fno-sanitize-recover -DLOCAL"

# compile only:  c foo.cpp -o foo
alias c="g++ $CPPFLAGS_DEBUG"

# compile and run:
#   cr                  -> main.cpp
#   cr foo.cpp          -> foo.cpp
#   cr foo.cpp in.txt   -> foo.cpp, stdin from in.txt
cr() {
    local src="${1:-main.cpp}"
    local bin="${src%.cpp}"
    g++ $CPPFLAGS_DEBUG "$src" -o "$bin" || return
    if [ -n "$2" ]; then
        "./$bin" < "$2"
    else
        "./$bin"
    fi
}

# stress test:  st   -> compiles stress.cpp with -O2 (no sanitizers, for speed) and runs it
st() {
    g++ -Wall -std=c++17 -O2 stress.cpp -o stress && ./stress
}

# new problem:  np A   -> copies ctemplate to ./A and cds into it
np() {
    cp -r /mnt/c/Code/competitive-programming/cpp/ctemplate "$1" && cd "$1"
}