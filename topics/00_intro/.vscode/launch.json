{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": ["<", "${fileDirname}/in.txt"],
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "preLaunchTask": "C/C++: g++ build active file",
            "stopAtEntry": false
        }
    ]
}